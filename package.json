{
  "name": "monotributodev",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test": "node --test tests/domain.test.mjs tests/simulator.test.mjs tests/automatic-simulator.test.mjs tests/movements.test.mjs tests/quotes.test.mjs tests/catalogs.test.mjs tests/cuit-content.test.mjs tests/api.test.mjs community-api/tests/*.test.mjs",
    "api:bundle": "wrangler deploy --config community-api/wrangler.jsonc --dry-run --outdir ../.monotributodev-api-bundle",
    "quotes:snapshot": "node scripts/update-quote-snapshot.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "wrangler": "^4.155.0"
  }
}
